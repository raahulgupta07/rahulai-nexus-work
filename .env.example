# CityAgent Insights - environment configuration
#
# Copy this file to `.env` and fill in the two values marked REQUIRED.
# Everything else has a working default and can be left alone.
#
#   cp .env.example .env
#   chmod 600 .env
#
# ---------------------------------------------------------------------------
# READ THIS FIRST
#
# DASH_ENCRYPTION_KEY is generated ONCE, at install, and must NEVER change
# afterwards. It decrypts every stored credential: connector passwords, OAuth
# refresh tokens, LDAP bind passwords, SSO client secrets, the model API key.
#
# If it is missing the application DOES NOT STOP. It prints
#
#   WARNING: encryption key is empty or unresolved; a new one has been
#   generated. If this installation already stored any credentials, they can
#   no longer be decrypted.
#
# generates a throwaway key, and serves a stack that reports perfectly healthy.
# On a genuinely new install that is correct. On any other it is permanent
# data loss announced by one line in a start-up log. Nothing downstream fails
# loudly; credentials simply stop working.
#
# (This block used to claim start-up REFUSES to continue. It does not, and has
# never done so - config.py generates the key and carries on. The claim is
# corrected rather than the behaviour, because refusing to start would break
# every existing installation that relies on the generated key on first boot.)
#
# Set it, then back this file up somewhere off the server. A database backup
# will NOT recover it.
#
# UPGRADING A MACHINE INSTALLED BEFORE THE RENAME: its .env says
# BOW_ENCRYPTION_KEY / BOW_DATABASE_URL. Both spellings are still read - but
# rename them to DASH_ while you are in the file, so the compatibility layer
# stops being what stands between you and the paragraph above.
# ---------------------------------------------------------------------------
#
# EVERY setting below reaches the application. The compose files pass this
# whole file through, so a key you add here takes effect on the next start.
# A setting you leave out is genuinely unset, and the code default applies -
# an empty value is NOT the same as an absent one, and for a few settings
# (FRONTEND_DIST_DIR, for one) an empty value would break startup. When in
# doubt, delete the line rather than blanking it.
#
# Defaults quoted in the comments live in backend/app/settings/config.py.
# ---------------------------------------------------------------------------


# === REQUIRED ==============================================================

# Generate with:  openssl rand -base64 32
# Set once. Never change. If it is missing the app does NOT stop — it warns
# once and generates a throwaway key. See READ THIS FIRST above.
DASH_ENCRYPTION_KEY=

# Generate with:  openssl rand -base64 24
# There is no default. Postgres will not initialise without it.
POSTGRES_PASSWORD=


# === PRODUCTION (SSL) ======================================================
#
# ★★★REQUIRED for a production install, and there is no warning if you forget
# it. docker-compose.yaml and the Caddyfile both fall back to the literal
# string `localhost`, so Caddy comes up, reports healthy, and issues itself a
# self-signed certificate for a name nobody browses to. Every browser then
# refuses the site, and nothing in the logs says why. Set it to the DNS name
# that already points at this server.
#
# Certificates are obtained and renewed automatically. That needs, before the
# first start: DNS for this name resolving to this machine's public address,
# and inbound 80 and 443 open (80 is how the certificate is issued - closing
# it does not make the site more secure, it makes HTTPS impossible).
#
# Leave this out entirely on a development install; it is read only by
# docker-compose.yaml.

#DOMAIN=insights.yourcompany.com


# === PORTS AND NAMES =======================================================
#
# ★APP_PORT and POSTGRES_PORT apply to docker-compose.dev.yaml only. The SSL
# file (docker-compose.yaml) publishes neither service on the host - the
# application is reachable only through Caddy on 80/443 - so setting them
# there has no effect and `curl localhost:8095` will not answer.
#
# ★★★That difference is a security property, not a detail. The development
# file publishes Postgres on POSTGRES_PORT. On a cloud server whose firewall
# or security group allows that port, the database is then reachable from the
# internet with the password above. Production publishes only Caddy.

APP_PORT=8095
POSTGRES_PORT=5440

# ★The database user and database name. Postgres applies these ONLY when it
# creates an empty data directory, so they name the database this install is
# about to create and nothing else. Editing them later does not rename
# anything — the running database keeps the names it was built with, and the
# application then tries to connect to one that does not exist.
#
# So: choose them before the first `up -d`, then leave them alone forever.
#
# Installations created before this file said `dash` hold `bow` /
# `bagofwords`, inherited from the upstream project. If that is yours, keep
# these two lines exactly as that machine already has them. preflight.sh and
# upgrade.sh compare these values against what the running database actually
# reports and stop if they disagree.
POSTGRES_USER=dash
POSTGRES_DB=dash_insights


# === RECOMMENDED FEATURES ==================================================

# Seed three ready-to-use agents on the very first signup (Microsoft Fabric,
# Power BI, City Mart Retail sample warehouse). Only ever fires on a completely
# empty database - an existing install can never be re-seeded.
SEED_DEFAULT_AGENTS=true

# Show the Microsoft Fabric connector in the Add Connection catalogue.
HYBRID_FABRIC_USER=true

# Let members keep private instructions on a shared agent. Required for
# per-user connectors where each member signs in with their own account.
PER_USER_INSTRUCTIONS=true

# Strip the {uuid}_ prefix from uploaded-file table names, so the agent writes
# SQL against `sales_2026` instead of `t_22b02300_..._sales_2026`.
CLEAN_FILE_TABLE_NAMES=true


# === OPTIONAL FEATURES =====================================================
# All default off. Turn on deliberately.

# Each member picks which of THEIR accessible tables their agent uses, and
# trains a private overview on that selection. Fabric / Power BI only.
HYBRID_PER_USER_TABLE_SELECT=false

# Live stage-by-stage progress bar while an agent learns, instead of a spinner.
HYBRID_LEARN_PROGRESS=false

# App Analytics page in the nav, below Monitoring.
HYBRID_APP_ANALYTICS=false

# Run agent-generated Python on the user's own laptop via a paired helper,
# so local files are analysed in place and never uploaded.
HYBRID_LOCAL_RUNTIME=false

# Attach a laptop folder to a chat turn from the paperclip menu.
# Requires HYBRID_LOCAL_RUNTIME.
HYBRID_LOCAL_FOLDER_ATTACH=false

# Unused stub for a browser-WASM local compute path. Leave off.
HYBRID_LOCAL_COMPUTE=false

# Split an overweight primary instruction into a lean dictionary plus
# on-demand skills. File agents only.
INSTRUCTION_IMPROVE=false

# Structural Excel parser (unmerge, split tables, detect headers). Falls back
# to the legacy pandas path on any failure.
SMART_EXCEL_INGEST=false

# Let the model read an uploaded file and decide where it belongs (table,
# instruction, skill, knowledge) instead of routing on the file extension.
SMART_FILE_INTAKE=false

# Focus a chat turn on the files the user just uploaded rather than every
# file inherited from every bound agent.
SCOPE_CHAT_UPLOADS=true

# On an upload turn, also hide bound-agent tables so a clarifying question
# does not offer unrelated data sources.
SCOPE_UPLOADS_SUPPRESS_SCHEMA=true


# === DASHBOARD TRUST =======================================================
# All three default ON. Uncomment only to switch one off.

# A dashboard built on truncated data is refused with the reason, instead of
# rendering wrong numbers silently.
#HYBRID_ARTIFACT_COMPLETENESS_GATE=true

# Generated dashboard code must parse before it is stored.
#HYBRID_ARTIFACT_RENDER_PREFLIGHT=true

# Every dashboard gets a written summary whose every figure is checked
# against the dashboard's own data first.
#HYBRID_ARTIFACT_INSIGHTS=true

# Measure a generated deck's layout and record boxes whose text overflows.
# Records only; never blocks a deck.
#HYBRID_DECK_LAYOUT_CHECK=true

# Recover a widget's data when a dashboard step lost its result.
#HYBRID_ARTIFACT_DATA_RECOVERY=true

# Refuse a Power BI answer built on a truncated DAX result.
#HYBRID_PBI_TRUNCATION_GUARD=true


# === MODEL PROVIDER ========================================================
# Normally configured in the app after first signup, not here. These are the
# environment overrides, useful for an unattended install.

#OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#LLM_API_KEY=
#LLM_BASE_URL=
#LLM_MODEL=


# === EXTERNAL DATABASE (AWS RDS etc) =======================================
# Only if you are NOT using the bundled postgres container. Setting these
# replaces the compose-built connection string.

#DASH_DATABASE_HOST=
#DASH_DATABASE_PORT=5432
#DASH_DATABASE_NAME=
#DASH_DATABASE_USER=
#DASH_DATABASE_SSL_MODE=require
# IAM authentication instead of a password (RDS):
#DASH_DATABASE_AUTH_PROVIDER=
#DASH_DATABASE_AUTH_REGION=


# === EMAIL =================================================================
# Needed for invitations, password reset and email verification.

#EMAIL_AUTH=
#EMAIL_SMTP_HOST=
#EMAIL_SMTP_PORT=587
#EMAIL_SMTP_USER=
#EMAIL_SMTP_PASS=
#EMAIL_SMTP_SECURITY=starttls
#EMAIL_IMAP_HOST=
#EMAIL_IMAP_PORT=993
#EMAIL_IMAP_USER=
#EMAIL_IMAP_PASS=
#EMAIL_MS_CLIENT_SECRET=
#DASH_EMAIL_MAX_ATTACHMENT_BYTES=
#DASH_EMAIL_MAX_ATTACHMENTS=


# === MICROSOFT SIGN-ON =====================================================
# Single sign-on is normally configured in Settings > Identity Provider.
# These are the environment fallback.

#DASH_ENTRA_TENANT_ID=
#DASH_ENTRA_CLIENT_ID=
#DASH_ENTRA_CLIENT_SECRET=
# Sovereign clouds only - change the Microsoft login host.
#DASH_MS_LOGIN_BASE=


# === SERVING AND SCALE =====================================================
# ★Leave these OUT unless you are changing them. Several read a real path or
# number as their default, and an empty value is not the same as absent.

#SERVE_FRONTEND=1
#FRONTEND_DIST_DIR=/app/frontend/dist
#DASH_CORS_ALLOWED_ORIGINS=
#UVICORN_WORKERS=
#UVICORN_TCP_NODELAY=
#DASH_MAX_CONCURRENT_AGENTS=
#DASH_AGENT_TOOL_CONCURRENCY=
#DASH_SSE_HEARTBEAT_SECONDS=
#DASH_REINDEX_SWEEP_BATCH=


# === SCHEDULER =============================================================
# Only relevant when running more than one application host.

#DASH_SCHEDULER_DISABLED=
#DASH_SCHEDULER_LEADER=
#DASH_SCHEDULER_LOCK_PATH=


# === TELEMETRY =============================================================
# Deliberately empty. The upstream project's analytics key was removed from
# this build; leaving these blank keeps it that way.

#DASH_POSTHOG_KEY=
#DASH_POSTHOG_HOST=


# === CONNECTOR EXTRAS ======================================================

# Oracle thick-mode client (needed only for some older Oracle servers).
#ORACLE_THICK_MODE=
# Path to the QVD converter binary, for Qlik sources.
#QVD2PARQUET_BIN=
# Kerberos ticket cache, for Kerberos-authenticated warehouses.
#KRB5CCNAME=


# === ENTERPRISE ============================================================
# Not required. All enterprise features are already unlocked in this build.
DASH_LICENSE_KEY=


# === RUNNING TWO STACKS ON ONE HOST ========================================
#
# Everything in this block is OPTIONAL and every default reproduces a normal
# single-stack install exactly. It exists so that a second stack — the usual
# case being a dev environment beside production — can be described entirely
# HERE, in an untracked file, instead of by editing docker-compose.yaml.
#
# ★★★That distinction is the whole point. Both live servers had reached the
# state where docker-compose.yaml was locally modified, and `upgrade.sh`
# refuses to run on a dirty working tree — so every upgrade on those hosts was
# being done by hand, and a `git pull` risked a conflict in the one file the
# stack cannot boot without.

# The Compose project name. Volumes, the default network and the labels that
# preflight.sh and upgrade.sh use to FIND your stack are all derived from it.
# Two stacks on one host must not share it.
#DASH_PROJECT_NAME=cityagentinsights-dev

# Container names. Give each stack its own, so `docker exec` and a reverse
# proxy can address one specific container rather than whichever answers.
#DASH_APP_CONTAINER=app-insights-dev
#DASH_POSTGRES_CONTAINER=dash-postgres-dev

# ★★★DASH_POSTGRES_CONTAINER is not cosmetic when the network is shared. It is
# also what DASH_DATABASE_URL connects to. Compose gives every service its own
# name as a network alias, so two stacks on one shared network BOTH answer to
# `postgres` and Docker round-robins between them. Measured on the live host:
# each app reached the OTHER environment's database roughly half the time. It
# failed closed — the passwords differ, so the wrong database refused the
# connection rather than serving it — and presented as ~810 authentication
# failures a day, read for weeks as a rotated credential. It was DNS.

# Attach to a network something else created, instead of this stack's own
# private bridge. Needed when a reverse proxy has to reach the app by name.
# ★If you set these, set DASH_POSTGRES_CONTAINER too — see above.
#DASH_NETWORK_NAME=shared-network
#DASH_NETWORK_EXTERNAL=true

# ★★★Volume names, for installs whose volumes are ALREADY named something the
# defaults would not produce. Leave these unset unless that is true of yours:
# pointing a stack at a name no volume has does not fail, it creates a fresh
# EMPTY one, and Postgres then initialises it and reports healthy. A new,
# blank installation is the failure mode, and nothing warns you.
#
# Check what yours are actually called before writing anything here:
#   docker inspect <app-container> --format '{{range .Mounts}}{{.Name}}{{"\n"}}{{end}}'
#DASH_POSTGRES_VOLUME=cityagentinsights-dev_postgres_data_dev
#DASH_UPLOADS_VOLUME=cityagentinsights-dev_uploads_data_dev
#DASH_BRANDING_VOLUME=cityagentinsights-dev_branding_data_dev
#DASH_LOGS_VOLUME=cityagentinsights-dev_logs_data_dev

# The image tag this stack runs. Give each release its own; never rebuild over
# the tag a running container was started from, and never let two stacks share
# one tag — a build on either then moves the image under the other.
#DASH_IMAGE=cityagentinsights:0.0.543.3

# Caddy (SSL) is OFF by default and starts only with `--profile caddy`. If
# something else already terminates SSL — nginx-proxy-manager, an ALB,
# Cloudflare — leave it off. Do not delete the service to disable it.
