<template>
  <!-- Additive help sidebar shown BESIDE the connector form. Purely read-only:
       it never touches the form. If anything here fails, the form still works. -->
  <aside
    v-if="hasAnything"
    class="cx-help-panel rounded-lg border border-amber-200 dark:border-amber-900/60 bg-amber-50/60 dark:bg-amber-950/20 flex flex-col overflow-hidden"
  >
    <!-- Header -->
    <div class="px-3.5 py-2.5 border-b border-amber-200/70 dark:border-amber-900/50 flex items-center gap-1.5">
      <span class="text-sm">📖</span>
      <h4 class="text-sm font-semibold text-gray-800 dark:text-gray-100">How to get each value</h4>
    </div>

    <!-- Scroll region: keeps a long help list from stretching the modal -->
    <div class="cx-help-scroll px-3.5 py-3 overflow-y-auto space-y-3">
      <!-- Overview -->
      <p v-if="doc?.overview" class="text-xs leading-relaxed text-gray-600 dark:text-gray-300">
        {{ doc.overview }}
      </p>

      <!-- One-time setup (do first) -->
      <div
        v-if="oneTimeSetup.length"
        class="rounded-md border border-dashed border-amber-300 dark:border-amber-800 bg-white/60 dark:bg-gray-900/40 px-3 py-2.5"
      >
        <div class="text-[11px] font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-400 mb-1.5">
          One-time setup (do first)
        </div>
        <ol class="list-decimal ms-4 space-y-1">
          <li v-for="(s, i) in oneTimeSetup" :key="i" class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed">
            {{ s }}
          </li>
        </ol>
      </div>

      <!-- Per-field cards -->
      <div v-if="cards.length" class="space-y-2">
        <div
          v-for="card in cards"
          :key="card.name"
          class="rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2.5"
        >
          <div class="flex items-center justify-between gap-2 mb-1">
            <div class="text-xs font-semibold text-gray-800 dark:text-gray-100">{{ card.label }}</div>
            <span
              :class="[
                'text-[9px] font-medium uppercase tracking-wide px-1.5 py-0.5 rounded shrink-0',
                card.required
                  ? 'text-red-600 bg-red-50 dark:bg-red-950 dark:text-red-400'
                  : 'text-gray-500 bg-gray-100 dark:bg-gray-800 dark:text-gray-400'
              ]"
            >
              {{ card.required ? 'Required' : 'Optional' }}
            </span>
          </div>

          <p v-if="card.note" class="text-[11px] text-gray-500 dark:text-gray-400 leading-relaxed mb-1.5">
            {{ card.note }}
          </p>

          <div
            v-if="card.where"
            class="text-[11px] leading-relaxed text-gray-700 dark:text-gray-200 bg-amber-100/50 dark:bg-amber-950/30 border border-amber-200/70 dark:border-amber-900/40 rounded px-2 py-1.5"
          >
            {{ card.where }}
          </div>

          <div v-if="card.example" class="mt-1.5">
            <span class="text-[9px] uppercase tracking-wide text-gray-400">Example</span>
            <code class="block mt-0.5 text-[11px] font-mono text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-gray-800 rounded px-2 py-1 break-all">{{ card.example }}</code>
          </div>

          <div v-if="card.warn" class="mt-1.5 flex items-start gap-1 text-[11px] text-amber-700 dark:text-amber-400">
            <UIcon name="heroicons-exclamation-triangle" class="w-3.5 h-3.5 mt-0.5 shrink-0" />
            <span class="leading-relaxed">{{ card.warn }}</span>
          </div>
        </div>
      </div>

      <!-- Troubleshooting -->
      <div
        v-if="troubleshooting.length"
        class="rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2.5"
      >
        <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1.5">
          Troubleshooting
        </div>
        <ul class="space-y-1">
          <li v-for="(t, i) in troubleshooting" :key="i" class="text-[11px] text-gray-600 dark:text-gray-300 leading-relaxed flex gap-1.5">
            <span class="text-gray-400 shrink-0">•</span>
            <span>{{ t }}</span>
          </li>
        </ul>
      </div>

      <!-- Official documentation -->
      <a
        v-if="doc?.officialDocsUrl"
        :href="doc.officialDocsUrl"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-xs text-blue-600 dark:text-blue-400 hover:underline"
      >
        <UIcon name="heroicons-book-open" class="w-3.5 h-3.5" />
        Official documentation
        <UIcon name="heroicons-arrow-top-right-on-square" class="w-3 h-3" />
      </a>

      <!-- Notes -->
      <p v-if="doc?.notes" class="text-[11px] text-gray-500 dark:text-gray-400 leading-relaxed border-t border-amber-200/60 dark:border-amber-900/40 pt-2">
        {{ doc.notes }}
      </p>

      <!-- Graceful minimal fallback when the connector has no curated metadata
           but we still rendered (e.g. only live field names available). -->
      <p v-if="!doc && cards.length" class="text-[11px] text-gray-400 dark:text-gray-500 leading-relaxed">
        Enter each field above. Values usually come from your administrator, DBA, or the service's own console.
      </p>
    </div>
  </aside>
</template>

<script setup lang="ts">
import { getConnectorDoc, type ConnectorDoc } from '~/utils/connectorDocs'

const props = defineProps<{
  connectorType: string
  // Optional live field names (from the connector's fetched schema). When
  // omitted, the panel fetches them itself, and finally falls back to the
  // curated connectorDocs keys.
  fields?: string[]
}>()

// Curated docs (may be undefined for connectors without an entry). Guarded so a
// bad type can never throw and break the surrounding modal.
const doc = computed<ConnectorDoc | undefined>(() => {
  try { return getConnectorDoc(props.connectorType) } catch { return undefined }
})

// --- field ordering: prefer explicit prop, then curated keys -----------------
// (No self-fetch — the panel renders purely from connectorDocs so it can never
//  fail on a network/context issue and take the form down with it.)
const orderedFieldNames = computed<string[]>(() => {
  if (props.fields && props.fields.length) return props.fields
  return Object.keys(doc.value?.whereToGet || {})
})
const liveRequired = { has: (_: string) => false }
const liveTitles: Record<string, string> = {}

interface FieldCard {
  name: string
  label: string
  required: boolean
  where?: string
  note?: string
  example?: string
  warn?: string
}

const cards = computed<FieldCard[]>(() =>
  orderedFieldNames.value.map((name) => {
    const meta = doc.value?.fieldMeta?.[name]
    const required = meta?.required ?? liveRequired.has(name)
    return {
      name,
      label: liveTitles[name] || name.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
      required,
      where: doc.value?.whereToGet?.[name],
      note: meta?.note,
      example: meta?.example,
      warn: meta?.warn,
    }
  })
)

const oneTimeSetup = computed<string[]>(() => doc.value?.oneTimeSetup || [])
const troubleshooting = computed<string[]>(() => doc.value?.troubleshooting || [])

// Show the panel when there is any curated doc OR at least one field card.
const hasAnything = computed(() => !!doc.value || cards.value.length > 0)
</script>

<style scoped>
.cx-help-scroll {
  max-height: 60vh;
}
</style>
